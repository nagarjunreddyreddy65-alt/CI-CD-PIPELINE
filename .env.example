# ==============================================================================
# Autonomous DevOps: Environment Configuration
# ==============================================================================
# Copy this template to .env:
#   cp .env.example .env
#
# SECURITY NOTICE:
# - In development/testing, default fallback credentials are functional.
# - In production (ENVIRONMENT=production), you MUST generate secure keys
#   and override SECRET_KEY, RUNNER_API_KEY, and DATABASE_URL.
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Autonomous DevOps: An AI-Driven Approach for Intelligent CI/CD Pipeline Optimization"
VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Server Bind Settings
HOST=127.0.0.1
PORT=8000

# Security & Runner Authentication
# Generate strong 32-byte production keys with: openssl rand -hex 32
SECRET_KEY=autonomous_devops_insecure_default_secret_key_change_in_production
RUNNER_API_KEY=autonomous_devops_runner_dev_api_key_2026
GITHUB_WEBHOOK_SECRET=autonomous_devops_webhook_dev_secret

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://user:password@host:port/dbname
POSTGRES_USER=devops_user
POSTGRES_PASSWORD=devops_secure_password_2026
POSTGRES_DB=autonomous_devops_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://devops_user:devops_secure_password_2026@localhost:5432/autonomous_devops_db

# Fallback SQLite Database for Local Development / Offline Testing
SQLITE_FALLBACK_URL=sqlite:///./autonomous_devops_local.db
USE_SQLITE_FALLBACK=True

# Machine Learning & Model Registry
MODEL_REGISTRY_PATH=./app/ml/models
MIN_TRAINING_RUNS=15
RISK_THRESHOLD=0.35
PREDICTION_CONFIDENCE_THRESHOLD=0.70

# Deterministic Safety Policy Configuration
STRICT_FALLBACK_MODE=True
MAX_UNRESOLVED_DYNAMIC_IMPORTS=0

# Security Scanners
ENABLE_BANDIT_SCAN=True
ENABLE_PIP_AUDIT=True
ENABLE_GITLEAKS=True
BLOCK_ON_SECURITY_SEVERITY=HIGH
